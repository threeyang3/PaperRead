{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://paperflow.local/schemas/ai-analysis.schema.json",
  "title": "PaperFlow AI Analysis Record",
  "type": "object",
  "required": ["schema_version", "paper_uid", "analysis_id", "identity", "created_at", "publisher", "status", "analysis", "extensions"],
  "properties": {
    "schema_version": {"const": 1},
    "paper_uid": {"type": "string", "minLength": 1},
    "analysis_id": {"type": "string", "minLength": 8},
    "identity": {"type": "object"},
    "analyzed_at": {"type": "string"},
    "created_at": {"type": "string"},
    "publisher": {"type": "string"},
    "status": {"type": "string"},
    "analysis": {"type": "object"},
    "extensions": {"type": "object"}
  },
  "additionalProperties": false
}
