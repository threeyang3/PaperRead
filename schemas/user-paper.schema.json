{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://paperflow.local/schemas/user-paper.schema.json",
  "title": "PaperFlow User Paper Record",
  "type": "object",
  "required": ["schema_version", "paper_uid", "user", "extensions"],
  "properties": {
    "schema_version": {"const": 1},
    "paper_uid": {"type": "string", "minLength": 1},
    "user": {"type": "object"},
    "extensions": {"type": "object"}
  },
  "additionalProperties": false
}
